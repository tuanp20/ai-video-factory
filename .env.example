# .env.example — Copy this to .env and fill in your real values
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxx.r2.dev

REDIS_URL=redis://localhost:6379/0

PLENXAI_API_KEY=your_plenxai_api_key
PLENXAI_BASE_URL=https://plenxai.com
GEMINI_API_KEY=your_gemini_api_key

DATABASE_URL=sqlite:///./ai_video_factory.db
TTS_VOICE=vi-VN-HoaiMyNeural
TEMP_DIR=tmp_processing

DEFAULT_VIDEO_MODEL=kling-3.0
DEFAULT_VIDEO_MODE=i2v
DEFAULT_VIDEO_QUALITY=1080p
DEFAULT_VIDEO_DURATION=5
DEFAULT_ASPECT_RATIO=9:16
